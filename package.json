{
  "name": "r3",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "r3 — Review. Revise. Resolve. A local-first review tool for AI-generated code and docs.",
  "license": "MIT",
  "bin": {
    "r3": "./cli/index.ts"
  },
  "scripts": {
    "postinstall": "$npm_execpath node_modules/bun2nix/index.ts -o bun.nix",
    "dev": "R3_DEV=1 bun --watch server/index.ts",
    "build": "bun scripts/compile.ts",
    "cli": "bun cli/index.ts",
    "gen:demo": "bun scripts/gen-demo-fixtures.ts",
    "build:demo": "bun scripts/build-demo.ts",
    "stage:pages": "bun scripts/stage-pages.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@tanstack/virtual-core": "3.17.4",
    "hono": "^4.12.30",
    "markdown-it": "^15.0.0",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@storybook/addon-themes": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "bun2nix": "2.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "overrides": {
    "bun": "npm:empty-npm-package@1.0.0"
  }
}
