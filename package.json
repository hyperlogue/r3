{
  "name": "r3",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "description": "r3 — Understand what's built. Steer what's next. Publish artifacts and discuss them with any coding agent.",
  "license": "MIT",
  "bin": {
    "r3": "./cli/index.ts"
  },
  "scripts": {
    "postinstall": "$npm_execpath node_modules/bun2nix/index.ts -o bun.nix",
    "dev": "R3_DEV=1 bun --watch server/index.ts",
    "build": "bun scripts/compile.ts",
    "cli": "bun cli/index.ts",
    "gen:demo": "bun scripts/gen-artifact-demo.ts",
    "build:demo": "bun scripts/build-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@tanstack/virtual-core": "3.17.11",
    "hono": "^4.13.8",
    "i18next": "26.4.2",
    "markdown-it": "^15.0.2",
    "react-i18next": "17.0.15",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.103.1",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "bun2nix": "2.1.2",
    "pagefind": "1.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "bun": "npm:empty-npm-package@1.0.0"
  }
}
