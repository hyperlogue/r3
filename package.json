{
  "name": "r3",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "r3 — Render. Review. Refine. View artifacts and give precise feedback to any coding agent.",
  "license": "MIT",
  "bin": {
    "r3": "./cli/index.ts"
  },
  "scripts": {
    "postinstall": "$npm_execpath node_modules/bun2nix/index.ts -o bun.nix",
    "dev": "R3_DEV=1 bun --watch server/index.ts",
    "build": "bun scripts/compile.ts",
    "cli": "bun cli/index.ts",
    "gen:demo": "bun scripts/gen-artifact-demo.ts",
    "build:demo": "bun scripts/build-demo.ts",
    "stage:pages": "bun scripts/stage-pages.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@tanstack/virtual-core": "3.17.11",
    "hono": "^4.13.7",
    "markdown-it": "^15.0.2",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "bun2nix": "2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "bun": "npm:empty-npm-package@1.0.0"
  }
}
