{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    // The demo fixtures are generated (one giant baked-HTML literal) — skip them.
    "includes": ["**", "!web/demo/artifact-fixtures.gen.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // r3 renders server-generated, trusted highlighted HTML and exposes
      // text-selection / clickable code-line surfaces; the CLI/HTTP-boundary
      // JSON helpers are deliberately `any`; `!` is idiomatic after a
      // just-inserted / known-present lookup.
      "security": { "noDangerouslySetInnerHtml": "off" },
      "a11y": { "noStaticElementInteractions": "off" },
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noExplicitAny": "off", "noArrayIndexKey": "off" }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  // Keep Biome 2.6's new Markdown and YAML formatters off; the Markdown one
  // breaks nested skill frontmatter.
  "markdown": { "formatter": { "enabled": false } },
  "yaml": { "formatter": { "enabled": false } },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
