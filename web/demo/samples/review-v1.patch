@@ -0,0 +1,14 @@
+type VersionBannerProps = {
+  latest: number;
+  selected: number;
+};
+
+export function VersionBanner({ latest, selected }: VersionBannerProps) {
+  if (latest === selected) return null;
+  return (
+    <aside className="version-banner" role="status">
+      <span>Version {latest} is available.</span>
+      <span>The workspace will open it automatically.</span>
+    </aside>
+  );
+}
