-import { useState } from "react";
+import { useEffect, useState } from "react";
+import { selectedVersion } from "./navigation";
+import { VersionBanner } from "./components/VersionBanner";

-export function Workspace({ versions, renderVersion }) {
-  const [selected, setSelected] = useState(versions.at(-1));
-  return renderVersion(selected, setSelected);
+type WorkspaceProps = {
+  versions: number[];
+  renderVersion: (seq: number) => React.ReactNode;
+};
+
+export function Workspace({ versions, renderVersion }: WorkspaceProps) {
+  const [selected, setSelected] = useState<number | null>(null);
+  const latest = versions.at(-1) ?? null;
+
+  useEffect(() => {
+    setSelected(selectedVersion(versions, selected));
+  }, [versions, selected]);
+
+  if (selected === null || latest === null) return <p>No publications yet.</p>;
+  return (
+    <main>
+      <VersionBanner latest={latest} selected={selected} />
+      {renderVersion(selected)}
+    </main>
+  );
 }
